{
  "name": "vocabi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "content:check": "tsx scripts/content/check.ts",
    "format": "prettier --write .",
    "content:build-reference": "tsx scripts/content/build-reference.ts",
    "content:near-words": "tsx scripts/content/near-words.ts",
    "prepare": "simple-git-hooks",
    "content:bands": "tsx scripts/content/build-bands.ts",
    "content:placement": "tsx scripts/content/build-placement.ts",
    "content:pseudowords": "tsx scripts/content/build-pseudowords.ts",
    "content:noa": "tsx scripts/content/extract-noa.ts",
    "content:starter": "tsx scripts/content/build-starter.ts"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "wink-lemmatizer": "3.0.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": "eslint --max-warnings=0 --no-warn-ignored"
  }
}
